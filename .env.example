# LINE Messaging API Credentials
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Base URL for Webhook & LIFF (e.g. ngrok or deployed server URL)
BASE_URL=http://localhost:8000

# LINE LIFF ID (Optional for web form verification)
LIFF_ID=your_liff_id_here

# Google Apps Script Webhook & Admin Email
GAS_WEBHOOK_URL=https://script.google.com/macros/s/your_gas_deployment_id/exec
ADMIN_EMAIL=genta2223@gmail.com

# Server Configuration
PORT=8000
HOST=0.0.0.0

